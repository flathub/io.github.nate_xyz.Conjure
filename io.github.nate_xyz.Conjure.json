{
    "app-id" : "io.github.nate_xyz.Conjure",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "46",
    "sdk" : "org.gnome.Sdk",
    "command" : "conjure",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name": "magick",
            "buildsystem": "autotools",
            "config-opts": [
                "--with-rsvg=yes"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://imagemagick.org/archive/releases/ImageMagick-7.1.1-47.tar.xz",
                    "sha256": "2396cd3c4237cfbc09a89d31d1cee157ee11fbc8ec1e540530e10175cb707160"
                }
            ]
        },
        "pypi-dependencies.json",
        {
            "name" : "conjure",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/nate-xyz/conjure",
                    "tag": "v0.1.2",
                    "commit":"bdbea03359109be6ebe0bea9fa5678c4ce541987"
                },
                {
                    "type" : "patch",
                    "path":"fix_appdata.patch"
                }
            ]
        }
    ]
}
